# Django Application Security & Debug
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[endpoint-hostname]/[database]?sslmode=require
DATABASE_URL=

# Cross-Origin Resource Sharing (CORS & CSRF)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External Discovery API (Geoapify - Optional with curated catalog fallback)
# Obtain a free key from https://www.geoapify.com/
GEOAPIFY_API_KEY=
GEOAPIFY_API_TIMEOUT=5

# Email Delivery Configuration (Resend Transactional Email & OTP)
RESEND_API_KEY=
EMAIL_FROM=GlobeTrotter <onboarding@resend.dev>
DEV_OTP_MODE=True

# OTP Security & Rate Limiting (Optional)
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Cloudinary Media Configuration (User avatar & trip covers)
# Obtain from Cloudinary Dashboard -> API Keys -> API Environment variable
CLOUDINARY_URL=



