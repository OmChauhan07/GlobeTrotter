# Django Application Security & Debug
DEBUG=False
SECRET_KEY=your-production-secret-key-min-50-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1,api.globetrotter.travel,.onrender.com,.railway.app

# Database Configuration (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[endpoint-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://globetrotter_user:secret_password@ep-sample-pooler.us-east-2.aws.neon.tech/globetrotter?sslmode=require

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://globetrotter.vercel.app

# External Discovery API (Geoapify)
# Obtain a free key from https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_places_api_key_here
GEOAPIFY_API_TIMEOUT=5

# Email Delivery Configuration (Resend Transactional Email)
# For development without a custom domain, use Resend's development sender: GlobeTrotter <onboarding@resend.dev>
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=GlobeTrotter <onboarding@resend.dev>

